# Stargate Environment Template
# Copy to .env and fill in actual values

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stargate
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Biometric
FACEPRINT_API_KEY=
ID_ME_API_KEY=

# Cloud
AWS_REGION=us-gov-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CBDC
CBDC_ENVIRONMENT=development
CBDC_NETWORK=testnet

# LegalTech
CJIS_COMPLIANCE=true
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key

# Logging
LOG_FORMAT=json
LOG_FILE=/var/log/stargate.log
